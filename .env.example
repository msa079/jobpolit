# ---- 对话模型：任何 OpenAI 兼容接口都可用 ----
# 模型名，例如 deepseek-chat / gpt-4o-mini / qwen-plus
MODEL_NAME=your-model-name
# 接口地址，通常需要带 /v1，例如 https://api.deepseek.com/v1
MODEL_BASE_URL=https://your-provider.example.com/v1
# 服务商给的 API Key
MODEL_API_KEY=your-api-key

# ---- 岗位搜索：Tavily ----
# 在 https://tavily.com 注册后获取，search_jobs 工具需要它
TAVILY_API_KEY=your-tavily-api-key
